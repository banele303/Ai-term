# ---------------------------------------------------------------------------
# AutoPulse AI — Convex + Whapi.cloud + Composio + OpenAI
# Copy the entries you need into .env.local (Next.js) and set the
# "Convex deployment" ones with:  npx convex env set NAME value
# ---------------------------------------------------------------------------

# --- Convex (written by `npx convex dev`) -----------------------------------
CONVEX_DEPLOYMENT=dev:successful-panda-540
NEXT_PUBLIC_CONVEX_URL=https://successful-panda-540.convex.cloud
# HTTP actions (webhooks) are served from the .convex.site domain
NEXT_PUBLIC_CONVEX_SITE_URL=https://successful-panda-540.convex.site

# --- Set on the Convex deployment (npx convex env set ...) ------------------
# Clerk "convex" JWT template issuer, e.g. https://your-app.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=
OPENAI_API_KEY=sk-...
COMPOSIO_API_KEY=
# Optional: Composio webhook signing secret (Project settings -> Webhooks)
COMPOSIO_WEBHOOK_SECRET=
WHAPI_API_TOKEN=
WHAPI_API_URL=https://gate.whapi.cloud
# Random string; append as ?secret=... to the Whapi webhook URL
WHAPI_WEBHOOK_SECRET=
# Public URL of the Next.js app, used to build quote payment links (/pay/{dealId})
APP_URL=http://localhost:3000
STORE_CURRENCY=ZAR
